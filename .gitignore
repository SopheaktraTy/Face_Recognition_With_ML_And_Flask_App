# Custom user files
*.bak
*.tmp

# Data science/ML artifacts
# You generally want to ignore large files, model weights, and intermediate results.
# NOTE: If your models/results are small and should be tracked, uncomment/remove these.
/data/
/models/
/results/
*.pkl
*.npy
*.csv
*.zip
*.h5
*.tf
*.onnx

# Flask/Gunicorn specifics
# SQLite databases or persistent storage files
*.sqlite
*.db

# Gunicorn logs (if not using standard error/stdout)
gunicorn.log
gunicorn-access.log

# VS Code directory (optional - only ignore if you don't share IDE settings)
.vscode/

# IDE specific files (PyCharm/IntelliJ)
.idea/